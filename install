#!/bin/bash
cd "$(dirname "$0")"
source scripts/lib.sh

command -v stow >/dev/null || pkg_install stow

git submodule init
git submodule update

# Move aside pre-existing real files/dirs (e.g. Omarchy's stock nvim config) so stow can link
backup_if_real() {
    if [ -e "$1" ] && [ ! -L "$1" ]; then
        echo "backup $1 -> $1.bak"
        mv "$1" "$1.bak"
    fi
}
backup_if_real ~/.config/nvim
backup_if_real ~/.tmux.conf
backup_if_real ~/.gitconfig

stow_files=("nvim" "tmux" "git")

# Omarchy-only packages: never linked on Debian/Ubuntu or plain Arch
if is_omarchy; then
    backup_if_real ~/.config/hypr/autostart.lua
    backup_if_real ~/.config/hypr/monitors.lua
    backup_if_real ~/.config/hypr/bindings.lua
    backup_if_real ~/.config/xkb
    backup_if_real ~/.local/bin/wayvnc-headless
    stow_files+=("hypr" "xkb" "bin")
fi

for folder in "${stow_files[@]}"; do
    echo "stow $folder"
    stow -D "$folder"
    stow "$folder"
done

# wayvnc: build the config from the template (no password in the repo) and make per-machine keys
setup_wayvnc() {
    local dir=~/.config/wayvnc
    mkdir -p "$dir"
    if [ ! -f "$dir/config" ]; then
        read -rsp "wayvnc password: " vnc_password; echo
        { cat wayvnc/config.template; echo "password=$vnc_password"; } > "$dir/config"
        chmod 600 "$dir/config"
    fi
    [ -f "$dir/rsa_key.pem" ] || { ssh-keygen -q -m pem -t rsa -N "" -f "$dir/rsa_key.pem" && rm -f "$dir/rsa_key.pem.pub"; }
    [ -f "$dir/tls_key.pem" ] || openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:secp384r1 -sha384 -days 3650 -nodes \
        -keyout "$dir/tls_key.pem" -out "$dir/tls_cert.pem" -subj "/CN=$(hostnamectl hostname)" 2>/dev/null
}

if is_omarchy; then
    setup_wayvnc
    # SDDM: log back in after logout so wayvnc comes back
    $SUDO install -Dm644 system/etc/sddm.conf.d/autologin.conf /etc/sddm.conf.d/autologin.conf
fi

# Shell: source from ~/.bashrc rather than replacing it (Omarchy owns .bashrc/.bash_profile)
line="[ -f \"$PWD/profile/.dotfiles_profile\" ] && source \"$PWD/profile/.dotfiles_profile\""
touch ~/.bashrc
grep -qF "profile/.dotfiles_profile" ~/.bashrc || echo "$line" >> ~/.bashrc

source ~/.bashrc
