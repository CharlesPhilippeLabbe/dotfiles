# Sourced from ~/.bashrc by ./install (works on Omarchy and Debian).

# Omarchy sets its own prompt (starship); only override elsewhere
if [[ -z "$OMARCHY_PATH" ]]; then
    parse_git_branch() {
         git branch 2> /dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/(\1)/'
    }
    export PS1="\u@\h \[\e[32m\]\w \[\e[91m\]\$(parse_git_branch)\[\e[00m\]$ "
fi

alias sesh=$HOME/dotfiles/scripts/tmuxsession.sh
